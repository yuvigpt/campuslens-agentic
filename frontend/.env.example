# Frontend environment - PUBLIC values only.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, so
# every value here ends up in shipped JavaScript.
#
# NEVER add a service_role key, a database URL or an AI key here: they would be
# published to every visitor. Those belong in backend/.env only.

# Base URL of the CampusLens FastAPI backend. No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase project URL and the PUBLIC anon key, used for sign-in only.
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
