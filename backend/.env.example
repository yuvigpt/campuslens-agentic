# ============================================================================
# CampusLens backend - environment template
#
# Copy to backend/.env and fill in real values. NEVER commit the filled file.
# Every value below is a PLACEHOLDER.
#
# The .env file is read for local development only (see app/config.py).
# In deployment these are injected as real environment variables instead.
# ============================================================================

# --- Supabase project -------------------------------------------------------
# Project Settings -> API. The URL is public; the keys are not.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The anon key is PUBLIC and is the only key the browser ever sees.
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Server-only. Bypasses RLS. Used ONLY for uploading complaint images and
# minting signed URLs - never for reading complaint rows.
# Dashboard -> Project Settings -> API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY

# Private bucket holding complaint images. Must have Public = OFF.
SUPABASE_BUCKET=CLimage

# --- Database ---------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the session (transaction) pooler for a serverless/pooled deployment.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- AI (optional) ----------------------------------------------------------
# The app is fully usable with AI disabled. Set AI_ENABLED=false to switch the
# provider off entirely; submissions then never call out to it.
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AGENTIC_ENABLED=true
DEMO_MODE=false

# --- CORS -------------------------------------------------------------------
# Comma-separated. Leave unset for the local Vite defaults (5173).
# Never use "*": this API authenticates with bearer tokens.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# FRONTEND (frontend/.env) - separate file, public values only
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
#
# Only VITE_-prefixed variables reach the browser bundle. NEVER put the
# service_role key or the Gemini key in a VITE_ variable - Vite would publish
# them to every visitor.
# ============================================================================
